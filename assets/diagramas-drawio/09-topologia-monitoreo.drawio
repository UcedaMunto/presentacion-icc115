=wrap;align=center;verticalAlign=middle;fontSize=12;fontFamily=Helvetica;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="490" width="360" height="60" as="geometry"/></mxCell><mxCell id="t25" value="" style="edgeStyle=none;html=1;strokeWidth=2.5;strokeColor=#8C4FFF;dashed=0;dashPattern=6 4;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="200" y="410" as="sourcePoint"/><mxPoint x="200" y="490" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t26" value="Las flechas siguen el camino de las métricas; Prometheus las obtiene consultando cada objetivo (scrape). El monitoreo corre fuera de OpenStack y de Kubernetes. Se descartó Telemetry de OpenStack: con passthrough no ve la GPU y obligaba a modificar Nova, RabbitMQ y Galera." style="text;html=1;fillColor=none;strokeColor=none;verticalAlign=middle;fontFamily=Helvetica;align=left;whiteSpace=wrap;fontSize=11.5;fontColor=#5B6672;" vertex="1" parent="1"><mxGeometry x="520" y="480" width="420" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>