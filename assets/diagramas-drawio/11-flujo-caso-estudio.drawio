e=none;html=1;strokeWidth=2.5;strokeColor=#374151;dashed=0;dashPattern=6 4;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="710" y="185" as="sourcePoint"/><mxPoint x="755" y="185" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t20" value="" style="edgeStyle=none;html=1;strokeWidth=2.5;strokeColor=#374151;dashed=0;dashPattern=6 4;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="790" y="230" as="sourcePoint"/><mxPoint x="370" y="330" as="targetPoint"/><Array as="points"><mxPoint x="790" y="280"/><mxPoint x="370" y="280"/></Array></mxGeometry></mxCell><mxCell id="t21" value="" style="edgeStyle=none;html=1;strokeWidth=2.5;strokeColor=#374151;dashed=0;dashPattern=6 4;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="455" y="385" as="sourcePoint"/><mxPoint x="515" y="385" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t22" value="" style="edgeStyle=none;html=1;strokeWidth=2.5;strokeColor=#374151;dashed=0;dashPattern=6 4;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="880" y="230" as="sourcePoint"/><mxPoint x="880" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t23" value="" style="edgeStyle=none;html=1;strokeWidth=2.5;strokeColor=#374151;dashed=0;dashPattern=6 4;endArrow=block;endFill=1;startArrow=none;startFill=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="892" y="385" as="sourcePoint"/><mxPoint x="940" y="385" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t24" value="1" style="ellipse;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="236" y="152" width="22" height="22" as="geometry"/></mxCell><mxCell id="t25" value="2" style="ellipse;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="486" y="152" width="22" height="22" as="geometry"/></mxCell><mxCell id="t26" value="3" style="ellipse;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="721" y="152" width="22" height="22" as="geometry"/></mxCell><mxCell id="t27" value="4" style="ellipse;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="569" y="269" width="22" height="22" as="geometry"/></mxCell><mxCell id="t28" value="5" style="ellipse;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="474" y="352" width="22" height="22" as="geometry"/></mxCell><mxCell id="t29" value="6" style="ellipse;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="869" y="269" width="22" height="22" as="geometry"/></mxCell><mxCell id="t30" value="7" style="ellipse;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="905" y="352" width="22" height="22" as="geometry"/></mxCell><mxCell id="t31" value="Cómo leer la figura: cada número es un paso del flujo" style="text;html=1;fillColor=none;strokeColor=none;verticalAlign=middle;fontFamily=Helvetica;align=left;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="490" width="1080" height="26" as="geometry"/></mxCell><mxCell id="t32" value="&lt;b&gt;1&lt;/b&gt; · El usuario sube la foto de la persona y de la prenda desde el navegador.&lt;br&gt;&lt;b&gt;2&lt;/b&gt; · VTON Studio valida la solicitud (máx. 3 activas) y encola el trabajo en PostgreSQL.&lt;br&gt;&lt;b&gt;3&lt;/b&gt; · El worker toma el trabajo más antiguo (hasta 3 reintentos).&lt;br&gt;&lt;b&gt;4&lt;/b&gt; · El worker llama a vton-api con su X-API-Key; un candado deja una sola inferencia a la vez." style="text;html=1;fillColor=none;strokeColor=none;verticalAlign=middle;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#333333;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="540" height="110" as="geometry"/></mxCell><mxCell id="t33" value="&lt;b&gt;5&lt;/b&gt; · vton-api ejecuta el modelo en la GPU: ≈ 42 s con 30 pasos y 6 GiB de VRAM.&lt;br&gt;&lt;b&gt;6&lt;/b&gt; · El worker envía la foto de la prenda al descriptor (garment-describer, en CPU).&lt;br&gt;&lt;b&gt;7&lt;/b&gt; · El resultado es una imagen PNG con una descripción orientativa, que vuelve al navegador." style="text;html=1;fillColor=none;strokeColor=none;verticalAlign=middle;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#333333;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="570" y="520" width="530" height="110" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>