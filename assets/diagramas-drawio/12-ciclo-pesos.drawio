er;verticalAlign=middle;fontSize=11.5;fontFamily=Helvetica;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="285" y="85" width="200" height="90" as="geometry"/></mxCell><mxCell id="t9" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Volumen de Cinder&lt;/b&gt;&lt;br&gt;vton-ai-models · osa-node3 (LVM, iSCSI)" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#E7157B;strokeWidth=2.5;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11.5;fontFamily=Helvetica;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="575" y="85" width="220" height="90" as="geometry"/></mxCell><mxCell id="t10" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;VM ai&lt;/b&gt;&lt;br&gt;montado en /var/lib/docker/vton-ai-models" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#326CE5;strokeWidth=2.5;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11.5;fontFamily=Helvetica;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="860" y="85" width="225" height="90" as="geometry"/></mxCell><mxCell id="t11" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;Pod garment-describer&lt;/b&gt;&lt;br&gt;hostPath; carga best.pt al iniciar" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#DD344C;strokeWidth=2.5;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11.5;fontFamily=Helvetica;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="860" y="255" width="225" height="90" as="geometry"/></mxCell><mxCell id="t12" value="&lt;b style=&#x27;font-size:13px&#x27;&gt;JMeter (PC de administración)&lt;/b&gt;&lt;br&gt;mide la latencia por ssh -L y port-forward" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#ED7100;strokeWidth=2.5;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=11.5;fontFamily=Helvetica;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="285" y="255" width="225" height="90" as="geometry"/></mxCell><mxCell id="t13" value="" style="edgeStyle=none;html=1;strokeWidth=2.5;strokeColor=