gn=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="249" y="97" width="22" height="22" as="geometry"/></mxCell><mxCell id="t20" value="2" style="ellipse;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="529" y="97" width="22" height="22" as="geometry"/></mxCell><mxCell id="t21" value="3" style="ellipse;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="816" y="97" width="22" height="22" as="geometry"/></mxCell><mxCell id="t22" value="4" style="ellipse;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="961" y="204" width="22" height="22" as="geometry"/></mxCell><mxCell id="t23" value="5" style="ellipse;html=1;fillColor=#232F3E;strokeColor=#FFFFFF;strokeWidth=2;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#FFFFFF;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="589" y="289" width="22" height="22" as="geometry"/></mxCell><mxCell id="t24" value="Cómo leer la figura: cada número es un paso del ciclo" style="text;html=1;fillColor=none;strokeColor=none;verticalAlign=middle;fontFamily=Helvetica;align=left;fontSize=13;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="20" y="410" width="1080" height="26" as="geometry"/></mxCell><mxCell id="t25" value="&lt;b&gt;1&lt;/b&gt; · Se entrena MobileNetV3-Small con las 14 427 imágenes etiquetadas (con NVIDIA NIM y DeepSeek).&lt;br&gt;&lt;b&gt;2&lt;/b&gt; · El archivo de pesos best.pt se copia al volumen de Cinder vton-ai-models (osa-node3; LVM e iSCSI).&lt;br&gt;&lt;b&gt;3&lt;/b&gt; · El volumen se adjunta a la VM ai y queda montado en /var/lib/docker/vton-ai-models." style="text;html=1;fillColor=none;strokeColor=none;verticalAlign=middle;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#333333;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="20" y="440" width="540" height="100" as="geometry"/></mxCell><mxCell id="t26" value="&lt;b&gt;4&lt;/b&gt; · El pod lo lee por hostPath: al reiniciarse carga el best.pt nuevo.&lt;br&gt;&lt;b&gt;5&lt;/b&gt; · JMeter, desde la PC de administración, mide la latencia (pruebas E6 y E7).&lt;br&gt;&lt;b&gt;Clave:&lt;/b&gt; un archivo nuevo de pesos llega al volumen y basta reiniciar el pod; no se reconstruye la imagen." style="text;html=1;fillColor=none;strokeColor=none;verticalAlign=middle;fontFamily=Helvetica;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#333333;spacingTop=4;" vertex="1" parent="1"><mxGeometry x="570" y="440" width="530" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>